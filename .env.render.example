# ============================================
# VARIABLES DE ENTORNO PARA RENDER
# Copiar estos valores en Render → Environment
# ============================================

# Puerto (Render lo asigna solo, pero por si acaso)
PORT=3001

# URL de conexion a PostgreSQL de Render
# IMPORTANTE: Copiar el "Internal Database URL" que da Render
# Formato: postgresql://USUARIO:PASSWORD@HOST:PUERTO/NOMBRE_DB
DATABASE_URL=postgresql://escuelitafc_user:abc123@dpg-xxxxx.a.postgres.render.com:5432/escuela_futbol

# JWT Secret
JWT_SECRET=your_super_secret_key
